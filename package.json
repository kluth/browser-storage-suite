{
  "name": "browser-storage-suite",
  "version": "1.1.0",
  "description": "Cross-browser extension for managing LocalStorage, SessionStorage, Cookies, and IndexedDB across Chrome, Firefox, Edge, and derivatives.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "stryker": "stryker run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@faker-js/faker": "^9.5.0",
    "@opentelemetry/api": "^1.9.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "@tanstack/react-virtual": "^3.13.0",
    "es-toolkit": "^1.50.0",
    "fast-check": "^3.23.2",
    "lucide-react": "^0.475.0",
    "mermaid": "^11.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.0",
    "@stryker-mutator/vitest-runner": "^8.7.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.173.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wxt": "^0.19.16"
  }
}
