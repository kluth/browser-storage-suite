{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "mutate": [
    "src/domain/**/*.ts",
    "src/application/**/*.ts",
    "src/infrastructure/**/*.ts",
    "utils/**/*.ts",
    "!utils/browserApi.ts"
  ],
  "concurrency": 2,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  }
}
